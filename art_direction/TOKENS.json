{
  "meta": {
    "theme": "pastel_kawaii_y2k_pixel",
    "pixel_policy": {
      "anti_aliasing": "none",
      "outline_px": 1,
      "ui_scale": 3,
      "world_resolution": [320, 240]
    }
  },
  "colors": {
    "bg": {
      "void": "#0A0A14",
      "stage": "#111126",
      "panel": "#FFE8F0",
      "panel_alt": "#FFD4E8",
      "pastel": "#FFF0F5",
      "pastel_alt": "#FFE4EF"
    },
    "surface": {
      "card": "#F0D0FF",
      "card_soft": "#F8E0FF",
      "chip": "#FFD0E0",
      "chrome": "#C8D6FF"
    },
    "window": {
      "border": "#FF8CB0",
      "title_bar": "#FFB0CC",
      "fill": "#FFF4F8"
    },
    "text": {
      "primary": "#FFF6FF",
      "secondary": "#D6C5F3",
      "muted": "#9A6080",
      "inverse": "#1A1230",
      "dark": "#5A2040",
      "dark_muted": "#9A6080"
    },
    "brand": {
      "pink": "#FF79C6",
      "rose": "#FF4FA3",
      "lilac": "#B98CFF",
      "violet": "#8F66FF",
      "mint": "#89FFD1",
      "cyan": "#6DE6FF"
    },
    "status": {
      "success": "#77F7BF",
      "heal": "#89FFD1",
      "danger": "#FF4C7D",
      "warning": "#FFB347",
      "info": "#78C7FF",
      "cooldown": "#7A6B99"
    },
    "motif": {
      "heart": "#FF93C8",
      "crown": "#FFE38A",
      "ribbon": "#FF8FCF",
      "lace": "#E6D7FF",
      "spike": "#A7A0C8",
      "glitch": "#46D8FF"
    },
    "overlay": {
      "scrim": "rgba(8, 8, 16, 0.78)",
      "panel_scrim": "rgba(255, 220, 240, 0.82)",
      "cooldown": "rgba(16, 13, 28, 0.65)",
      "danger_glow": "rgba(255, 76, 125, 0.35)",
      "focus_glow": "rgba(109, 230, 255, 0.3)"
    }
  },
  "spacing": {
    "px": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "hud_gutter": 12
  },
  "radii": {
    "none": 0,
    "chip": 2,
    "panel": 4,
    "badge": 6
  },
  "typography": {
    "display": {
      "family": "Silkscreen",
      "weight": 400
    },
    "body": {
      "family": "Inter",
      "weights": {
        "regular": 400,
        "medium": 500,
        "bold": 700,
        "black": 800
      }
    },
    "pixel": {
      "family": "Silkscreen",
      "size": {
        "xs": 8,
        "sm": 10,
        "md": 12
      }
    }
  },
  "borders": {
    "ui": {
      "width": 2,
      "color": "#FF8CB0"
    },
    "danger": {
      "width": 2,
      "color": "#FF4C7D"
    },
    "focus": {
      "width": 2,
      "color": "#6DE6FF"
    }
  },
  "shadow_glow": {
    "panel_shadow": "2px 2px 0 rgba(255,140,176,0.18)",
    "pink_glow": "0 0 0 1px rgba(255,121,198,0.4)",
    "danger_glow": "0 0 8px rgba(255,76,125,0.35)",
    "focus_glow": "0 0 8px rgba(109,230,255,0.35)"
  },
  "window_controls": {
    "close": "#FF6B8A",
    "minimize": "#FFD166",
    "maximize": "#77DD77"
  },
  "telegraph_patterns": {
    "danger": "spike + magenta pulse",
    "heal": "heart + mint ripple",
    "quest": "ribbon tab + crown chip",
    "boss_intro": "chrome frame + warning stripe"
  }
}
